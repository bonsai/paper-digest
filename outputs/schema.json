{
  "schema_version": "1.0.0",
  "description": "Shared artifact contract for Paper Digest runs from Kaggle and Colab.",
  "required_files": [
    "run-manifest.json",
    "papers.csv",
    "chunks.jsonl",
    "keywords.csv",
    "download-results.jsonl",
    "extraction-errors.jsonl"
  ],
  "optional_files": [
    "keyword-cooccurrence.csv",
    "keyword-graph.html",
    "rag-answers.jsonl"
  ],
  "manifest_required_fields": [
    "schema_version",
    "run_id",
    "generated_at_utc",
    "paper_count",
    "page_aware_chunk_count",
    "keyword_count",
    "source_counts",
    "artifacts"
  ],
  "persistence": {
    "latest_path": "outputs/latest/",
    "history_pattern": "outputs/runs/<run-id>/",
    "publish_only_after_validation": true,
    "include_source_pdfs": false
  },
  "limits": {
    "max_git_artifact_mb": 5,
    "history_requires_compact_artifacts": true
  }
}
